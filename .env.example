# Copia este archivo a .env (no se versiona) y completa las claves.
# --- Componente de lenguaje (opcional; LangChain + LangGraph) ---
# Proveedor principal: Gemini
GEMINI_API_KEY=
# Lista en orden de preferencia (si uno está saturado se usa el siguiente)
JACOMIND_GEMINI_MODELO=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Proveedor de respaldo: Anthropic
ANTHROPIC_API_KEY=
JACOMIND_ANTHROPIC_MODELO=claude-opus-5-5
# Orden de proveedores y desactivación global (0 = solo plantillas deterministas)
JACOMIND_LLM_PROVEEDORES=gemini,anthropic
JACOMIND_LLM=1

# --- Servicio ---
JACOMIND_DB=var/jacomind.sqlite3
JACOMIND_SESION_MIN=480
# Piloto: identidad desde el proxy del proveedor aprobado (cabecera X-Usuario-Autenticado)
JACOMIND_PROXY_AUTH=0
# Integración con el carril A (formato modulo:funcion)
JACOMIND_IMPORTADOR=pipeline.importar:importar_archivo
JACOMIND_CLASIFICADOR=modelos.clasificador_pqrs:clasificar
JACOMIND_UMBRAL_PQRS=0.6
